# ------------------------------ Output ------------------------------
resolve_output() {
    local extension='txt' outdir today
    [[ "$FORMAT" == md ]] && extension='md'
    today=$(date '+%Y%m%d-%H%M%S')

    if [[ -z "$OUTPUT" ]]; then
        OUTPUT="$PWD/transcriptions-$today.$extension"
    elif [[ -d "$OUTPUT" ]]; then
        OUTPUT="${OUTPUT%/}/transcriptions-$today.$extension"
    elif [[ "$OUTPUT" == */ ]]; then
        outdir=${OUTPUT%/}
        mkdir -p "$outdir" || die "Cannot create output directory: $outdir"
        OUTPUT="$outdir/transcriptions-$today.$extension"
    fi

    outdir=$(dirname -- "$OUTPUT")
    mkdir -p "$outdir" || die "Cannot create output directory: $outdir"

    if [[ -e "$OUTPUT" ]] && (( ! FORCE )); then
        if ask_yes_no "Output exists: $OUTPUT. Overwrite it?" n; then
            :
        else
            local dir name
            dir=${OUTPUT%/*}; name=${OUTPUT##*/}
            [[ "$dir" == "$OUTPUT" ]] && dir='' || dir="$dir/"
            if [[ "$name" == *.* ]]; then
                OUTPUT="${dir}${name%.*}-$today.${name##*.}"
            else
                OUTPUT="${dir}${name}-$today"
            fi
            info "Keeping the existing file; writing to: $OUTPUT"
        fi
    fi
}

# -------------------------- Per-link pipeline ------------------------
download_link() {
    local url=$1 index=$2 log="$WORK/download-$2.log"
    local -a args=(--no-warnings --no-playlist --write-info-json
                   --paths "$WORK" -o "reel$index.%(ext)s")
    [[ -n "$COOKIES" ]] && args+=(--cookies "$COOKIES")
    [[ -n "$COOKIES_BROWSER" ]] && args+=(--cookies-from-browser "$COOKIES_BROWSER")
    run_with_spinner "Downloading..." "$log" "$YTDLP" "${args[@]}" "$url"
}

find_media() {
    local index=$1 candidate
    for candidate in "$WORK/reel$index".*; do
        [[ -f "$candidate" ]] || continue
        case "$candidate" in
            *.info.json|*.fields|*.part|*.ytdl|*.wav|*.txt|*.lang) continue ;;
        esac
        printf '%s\n' "$candidate"
        return 0
    done
    return 1
}

process_link() {
    local url=$1 index=$2 base="$WORK/reel$2" media log

    if ! download_link "$url" "$index"; then
        FAIL_MSG[$index]="download failed"
        FAILED_COUNT=$((FAILED_COUNT + 1))
        err "Download failed for $url"
        log="$WORK/download-$index.log"
        [[ -s "$log" ]] && tail -n 8 "$log" | while IFS= read -r line; do dim "$line"; done
        return 1
    fi
    ok "Downloaded."

    # Keep the reel's own metadata (account, date, length, caption) for the header.
    if [[ -f "$WORK/reel$index.info.json" ]]; then
        "$VENV/bin/python" "$PY_DIR/meta.py" "$WORK/reel$index.info.json" \
            > "$base.fields" 2>/dev/null || : > "$base.fields"
    fi

    if ! media=$(find_media "$index"); then
        FAIL_MSG[$index]="no media file produced"
        FAILED_COUNT=$((FAILED_COUNT + 1))
        err "No media file was produced for $url"
        return 1
    fi

    if ! "$FFMPEG" -nostdin -loglevel error -y -i "$media" -vn \
            -ac 1 -ar 16000 -c:a pcm_s16le "$base.wav" >>"$WORK/ffmpeg-$index.log" 2>&1; then
        FAIL_MSG[$index]="audio extraction failed"
        FAILED_COUNT=$((FAILED_COUNT + 1))
        err "Could not extract audio from $media"
        dim "See $WORK/ffmpeg-$index.log"
        return 1
    fi

    if ! "$VENV/bin/python" "$PY_DIR/transcribe.py" \
            "$base.wav" "$MODEL" "$LANGUAGE" "$TIMESTAMPS" "$PROMPT_TEXT" \
            "$base.txt" "$MODEL_DIR" "$DEVICE" "$COMPUTE" > "$base.lang" 2>"$WORK/whisper-$index.log"; then
        FAIL_MSG[$index]="transcription failed"
        FAILED_COUNT=$((FAILED_COUNT + 1))
        err "Transcription failed for $url"
        tail -n 8 "$WORK/whisper-$index.log" | while IFS= read -r line; do dim "$line"; done
        return 1
    fi

    if [[ -s "$base.txt" ]]; then
        local words unit
        words=$(wc -w < "$base.txt" | tr -d ' ')
        [[ "$words" == 1 ]] && unit=word || unit=words
        ok "Transcribed ($words $unit)."
    else
        ok "Processed; no spoken audio detected."
    fi
    return 0
}

# ----------------------------- Assembly -----------------------------
write_document() {
    local tmp="$OUTPUT.tmp.$$" n index url base
    local account channel uploader_id handle duration upload_date title description page_url label
    local posted language probability seconds

    {
        if [[ "$FORMAT" == md ]]; then
            printf '# Transcriptions\n\n'
            printf -- '- Generated: %s\n' "$(date '+%Y-%m-%d %H:%M')"
            printf -- '- Tool: yas-transcribe %s\n' "$YAS_TRANSCRIBE_VERSION"
            printf -- '- Model: %s\n' "$MODEL"
            printf -- '- Sources: %d\n' "$TOTAL"
        else
            printf 'TRANSCRIPTIONS\n'
            printf 'Generated %s by yas-transcribe %s\n' "$(date '+%Y-%m-%d %H:%M')" "$YAS_TRANSCRIBE_VERSION"
            printf 'Model: %s\n' "$MODEL"
            printf 'Sources: %d\n' "$TOTAL"
            printf 'Machine transcription, lightly punctuated: expect small errors.\n'
        fi

        for index in "${!LINKS[@]}"; do
            n=$((index + 1))
            url=${LINKS[index]}
            base="$WORK/reel$n"
            account=''; channel=''; uploader_id=''; handle=''
            duration=''; upload_date=''; title=''; description=''; page_url=''
            if [[ -f "$base.fields" ]]; then
                IFS=$'\x1f' read -r account channel uploader_id duration upload_date \
                    title description page_url < "$base.fields"
            fi
            handle=$channel
            [[ -n "$handle" ]] || handle=$uploader_id
            [[ "$handle" =~ ^[0-9]+$ ]] && handle=''
            if (( SHOW_CAPTION )) && [[ -n "$description" && "$description" != "Video by"* ]]; then
                if (( ${#description} > 400 )); then
                    description="${description:0:400}…"
                fi
            else
                description=''
            fi
            label=''
            if [[ -n "$account" && -n "$handle" && "$handle" != "$account" ]]; then
                label="$account (@$handle)"
            elif [[ -n "$account" ]]; then
                label="$account"
            elif [[ -n "$handle" ]]; then
                label="@$handle"
            fi

            posted=''
            [[ -n "$upload_date" ]] && posted="$upload_date"
            [[ -n "$duration" ]] && posted="${posted:+$posted — }length ~${duration}s"

            language=''; probability=''
            if [[ -f "$base.lang" ]]; then
                IFS=$'\t' read -r _ language probability seconds < "$base.lang"
            fi

            if [[ "$FORMAT" == md ]]; then
                printf '\n## %d. %s\n\n' "$n" "$url"
                [[ -n "$label" ]] && printf '**Account:** %s  \n' "$label"
                [[ -n "$posted" ]] && printf '**Posted:** %s  \n' "$posted"
                [[ -n "$language" ]] && printf '**Detected language:** %s (%s)  \n' "$language" "$probability"
                [[ -n "$description" ]] && printf '**Caption:** %s\n' "$description"
                printf '\n'
            else
                printf '\n%s\n' '==============================================================================='
                printf '%d) %s\n' "$n" "$url"
                [[ -n "$label" ]] && printf '   Account: %s\n' "$label"
                [[ -n "$posted" ]] && printf '   Posted: %s\n' "$posted"
                [[ -n "$description" ]] && printf '   Caption: %s\n' "$description"
                printf '%s\n\n' '==============================================================================='
            fi

            if [[ -n "${FAIL_MSG[n]:-}" ]]; then
                printf '[Transcription unavailable: %s]\n' "${FAIL_MSG[n]}"
                continue
            fi
            if [[ -s "$base.txt" ]]; then
                cat "$base.txt"
                printf '\n'
            else
                printf '[No spoken audio detected in this clip.]\n'
            fi
        done
    } > "$tmp" || { err "Could not write $tmp"; rm -f -- "$tmp"; return 1; }

    if ! mv -f -- "$tmp" "$OUTPUT"; then
        err "Could not move the document into place: $OUTPUT"
        rm -f -- "$tmp"
        return 1
    fi
    return 0
}

# ------------------------------- Setup -------------------------------
cleanup() {
    [[ -t 1 ]] && printf '\033[?25h'
    if [[ -n "$WORK" && -d "$WORK" ]]; then
        if (( KEEP_WORK )); then
            printf '  %s[i]%s  Scratch files kept: %s\n' "$CYAN" "$RESET" "$WORK"
        else
            rm -rf -- "$WORK"
        fi
    fi
}

WORK=$(mktemp -d "${WORK_PARENT%/}/yas-transcribe.XXXXXX") || {
    err "Cannot create a scratch directory under $WORK_PARENT"
    exit 1
}
trap cleanup EXIT
trap 'printf "\n"; warn "Interrupted."; exit 130' INT TERM

write_helpers

if (( CHECK_ONLY )); then
    report_status
    exit 0
fi

if (( SETUP_ONLY )); then
    step "Preparing yas-transcribe"
    setup_environment || exit 1
    ok "Ready. Run: yas-transcribe \"<links>\" -y"
    exit 0
fi

(( ${#LINKS[@]} )) || { usage >&2; exit 2; }
TOTAL=${#LINKS[@]}

resolve_output

printf '\n%s%s yas-transcribe %s %s\n' "$BOLD" "$MAGENTA" "$YAS_TRANSCRIBE_VERSION" "$RESET"
info "Links:  $TOTAL"
info "Output: $OUTPUT"
info "Model:  $MODEL ($DEVICE/$COMPUTE), language: $LANGUAGE"
info "Format: $FORMAT"

if (( DRY_RUN )); then
    step "Plan"
    index=1
    for url in "${LINKS[@]}"; do
        dim "$index. $url"
        index=$((index + 1))
    done
    info "Dry run: nothing was downloaded or transcribed."
    exit 0
fi

step "Checking requirements"
setup_environment || { err "Setup is incomplete; nothing was transcribed."; exit 1; }

step "Working"
index=0
for url in "${LINKS[@]}"; do
    index=$((index + 1))
    step "($index/$TOTAL) $url"
    process_link "$url" "$index"
done

step "Writing document"
if ! write_document; then
    err "The transcript document could not be written."
    exit 1
fi
ok "Saved to: $OUTPUT"

printf '\n'
if (( FAILED_COUNT )); then
    warn "$FAILED_COUNT of $TOTAL link(s) failed; they are marked in the document."
    printf '\n%s%s[PARTIAL]%s\n\n' "$BOLD" "$YELLOW" "$RESET"
    exit 1
fi
printf '%s%s[DONE]%s %d transcript(s) written.\n\n' "$BOLD" "$GREEN" "$RESET" "$TOTAL"
exit 0
